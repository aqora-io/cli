[project]
name = "{{ slug }}"
version = "0.1.0"
requires-python = ">={{ python_version }}"
dependencies = []

[dependency-groups]
dev = [
  "ruff",
  "ty",
  "watchdog",
  "nbconvert",
  "google-genai",
  "anthropic",
  "openai",
]

[build-system]
requires = ["pdm-backend"]
build-backend = "pdm.backend"

[tool.marimo.venv]
path = "/home/me/venv"
# marimo is already installed here; setting this true reinstalls it on every
# kernel start. `uv add` works either way.
writable = false
